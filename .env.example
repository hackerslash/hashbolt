# GitHub repo whose `index` release holds data.tsv.gz.enc (built by .github/workflows/index.yml)
INDEX_REPO=hackerslash/hashbolt
# The key the index is sealed with (seal.js): the same as the repo's INDEX_KEY Actions secret
INDEX_KEY=
# Optional: lifts GitHub's API rate limit; required only if the repo is private (fine-grained, Contents: read)
GITHUB_TOKEN=
# Public HTTPS URL Stremio reaches this server on (needed behind a reverse proxy)
BASE_URL=https://hashbolt.example.com
PORT=7001
DATA_FILE=./data.tsv

# Redis `hashlib` that consenting users' libraries are copied into (also read by `npm run build`)
REDIS_URL=rediss://default:password@host:6379
# Local `npm run build` only
HASHLISTS_DIR=./hashlists
